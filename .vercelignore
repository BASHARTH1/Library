# Everything the deployment does not need. Without this the CLI uploads the
# local PostgreSQL cluster (~1.5 GB) and trips the 100 MB per-file limit.

# Portable PostgreSQL cluster — machine-local state, recreated from docs/setup
.localdb/

# Generated corpus analysis; contains extracted research text
reports/

# Original research files: served from Vercel Blob in production
storage/
uploads/

# Phase-1 inspection tooling — runs locally, never in the deployment
tools/

# Build outputs are regenerated by `npm run vercel-build`
dist/
apps/api/dist/
apps/web/dist/
.angular/
*.tsbuildinfo

# Dependencies are installed on Vercel
node_modules/

# Local-only
.git/
.env
.env.local
*.log
coverage/
