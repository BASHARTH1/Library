# ============================================================================
# Gulf University Research Repository — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# The GEMINI_API_KEY is read ONLY by the NestJS backend / Node tooling.
# It must never appear in Angular environment files or any browser payload.
# ============================================================================

# --- Google Gemini -----------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
# Model names are ALWAYS read from env — never hardcoded in application services.
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Highest-capability tier (comparisons, literature reviews). Requires billing enabled.
GEMINI_DEEP_MODEL=gemini-3.1-pro-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536
GEMINI_MAX_RETRIES=5
GEMINI_TIMEOUT_MS=120000

# Embedding rate limits. Raise these once the project has billing enabled.
GEMINI_EMBED_BATCH=16
GEMINI_EMBED_RPM=90
GEMINI_EMBED_TPM=25000

# --- Database (PostgreSQL + pgvector) ---------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=gulf_research_repository
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password
DATABASE_SSL=false
# Optional single-URL form (Supabase / managed Postgres). Takes precedence when set.
DATABASE_URL=

# --- Auth --------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_with_another_secure_secret
JWT_REFRESH_EXPIRES_IN=7d

# --- File storage ------------------------------------------------------------
FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=./storage/research
MAX_UPLOAD_SIZE_MB=100

# S3 / MinIO (production)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=gulf-research
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Ingestion source (read-only; originals are never modified) --------------
RESEARCH_SOURCE_DIR=C:\Users\Bashar\Desktop\رسائل الماجستير

# --- App ---------------------------------------------------------------------
NODE_ENV=development
PORT=3100
FRONTEND_ORIGIN=http://localhost:4200
DEFAULT_LOCALE=ar

# --- AI cost & rate controls -------------------------------------------------
AI_DAILY_TOKEN_LIMIT_PER_USER=200000
AI_MAX_CHAT_HISTORY=20
AI_MAX_RETRIEVED_CHUNKS=12
AI_CACHE_TTL_SECONDS=86400
